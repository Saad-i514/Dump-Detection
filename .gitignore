# --- model weights ---
# Keep model binaries local or in the private AWS deployment bundle.
models/*.pt
models/*.onnx
!models/.gitkeep

# Ultralytics downloads weights into the working directory when handed a bare
# model name, so stray copies can appear at the repo root.
/*.pt
/*.onnx

# --- runtime data ---
data/detections.db
data/uploads/
data/results/

# samples/road_02.jpg is the retained API integration-test fixture.

# --- python ---
__pycache__/
*.py[cod]
.pytest_cache/
.venv/
venv/
*.egg-info/

# --- ultralytics ---
runs/

# --- os / editor ---
.DS_Store
Thumbs.db
.vscode/
.idea/

# Local models, credentials, and server logs
models/backup*/
new_trained_model/
*.log
.env
.env.*
!.env.example
.deploy/
infra/.terraform/
infra/*.tfstate*
infra/*.tfplan
infra/*.auto.tfvars
infra/crash.log
